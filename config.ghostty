config-file = ?auto/theme.ghostty

# Use Bitwarden's SSH agent for shells launched by Ghostty.
env = SSH_AUTH_SOCK=/Users/miter/.bitwarden-ssh-agent.sock

# Font settings from ~/.config/wezterm/miter/fonts.lua (macOS).
font-size = 12

# Regular and bold: Argon, with MiSans for Chinese.
font-family = Monaspace Argon
font-family = MiSans
font-style = Regular

font-family-bold = Monaspace Argon
font-family-bold = MiSans
font-style-bold = Bold

# Match WezTerm's Xenon Regular/Bold faces for italic text.
font-family-italic = Monaspace Xenon
font-family-italic = LXGW Neo ZhiSong
font-style-italic = Regular

font-family-bold-italic = Monaspace Xenon
# LXGW Neo ZhiSong has no Bold face; Ghostty currently falls back to
# the regular Chinese font (MiSans) for bold italic characters.
font-family-bold-italic = LXGW Neo ZhiSong
font-style-bold-italic = Bold

# OpenType features and ligatures.
font-feature = calt=1
font-feature = ss01=1
font-feature = ss02=1
font-feature = ss03=1
font-feature = ss07=1
font-feature = ss08=1
font-feature = ss09=1
font-feature = liga=1

# tmux uses the same Alt shortcuts as WezTerm.
# Treat both Option keys as Alt, regardless of the active keyboard layout.
macos-option-as-alt = true

# Forward real Alt+arrow keys to tmux instead of Ghostty's word movement.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# Match WezTerm clipboard shortcuts; also works when tmux is remote.
keybind = alt+shift+v=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard
